# Supabase — create a project at https://supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Optional: Cal.com embed overrides (EU accounts use app.cal.eu)
# VITE_CAL_ORIGIN=https://cal.com
# VITE_CAL_EMBED_JS_URL=https://app.cal.com/embed/embed.js

# --- Server-only (set in Vercel project settings, never prefix with VITE_) ---
# Pesapal API 3.0 — get keys from https://developer.pesapal.com
PESAPAL_ENV=sandbox                 # "sandbox" or "live"
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=                     # IPN ID registered for https://<your-site>/api/pesapal-ipn
SITE_URL=https://your-site.com      # used for Pesapal callback/cancel URLs
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # server only — bypasses RLS
# Automated emails (Resend). Without RESEND_API_KEY, emails are logged as "skipped".
RESEND_API_KEY=
RESEND_FROM="Lauture Global <hello@lautureglobal.com>"   # must be on a domain verified in Resend
RESEND_REPLY_TO=info@lautureglobal.com
TEAM_NOTIFY_EMAIL=info@lautureglobal.com                # receives new-enquiry and payment alerts
NOTIFY_WEBHOOK_SECRET=                                  # long random string; same value in the Supabase webhooks
